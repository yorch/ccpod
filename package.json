{
  "name": "ccpod",
  "version": "0.7.0",
  "license": "MIT",
  "description": "Run Claude Code in Docker containers with portable, composable configuration",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24",
    "bun": ">=1"
  },
  "scripts": {
    "dev": "bun run src/cli/index.ts",
    "build": "bun build --compile --minify src/cli/index.ts --outfile dist/ccpod",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "biome check --write .",
    "check:ci": "biome check .",
    "verify": "bun run check:ci && bun run typecheck && bun test && bun run build",
    "changeset": "changeset",
    "version-packages": "changeset version && bun install"
  },
  "dependencies": {
    "@inquirer/prompts": "8.4.2",
    "chalk": "5.6.2",
    "citty": "0.2.2",
    "deepmerge": "4.3.1",
    "simple-git": "3.36.0",
    "yaml": "2.8.3",
    "zod": "4.4.1"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.0",
    "@changesets/cli": "3.0.1",
    "@biomejs/biome": "2.4.13",
    "@types/bun": "1.3.13",
    "@types/node": "25.6.0",
    "typescript": "6.0.3"
  }
}
